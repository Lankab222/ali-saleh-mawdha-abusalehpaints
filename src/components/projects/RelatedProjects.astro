---
import SmartImage from "../common/SmartImage.astro";
interface ProjectItem { id: string; data: { title: string; description: string; category: string; coverImage?: string; coverImageAlt?: string; location?: string; }; }
interface Props { projects: ProjectItem[]; }
const { projects } = Astro.props;
---
{projects.length > 0 && <section class="related-projects"><header><span>مشاريع أخرى</span><h2>قد تهمك هذه الأعمال</h2></header><div>{projects.map((project) => <article><a href={`/projects/${project.id}/`}>{project.data.coverImage && <SmartImage src={project.data.coverImage} alt={project.data.coverImageAlt || project.data.title} width={800} height={600} sizes="(min-width: 720px) 33vw, 100vw" role="project" />}<div class="overlay"></div><section><span>{project.data.category}</span><h3>{project.data.title}</h3><p>{project.data.description}</p></section></a></article>)}</div></section>}
<style>
  .related-projects { margin-top: 4rem; }
  header { margin-bottom: 1.4rem; }
  header span { color: var(--color-primary-dark); font-weight: 800; }
  header h2 { margin-block: .45rem 0; font-size: clamp(1.7rem, 4vw, 2.4rem); }
  .related-projects > div { display: grid; gap: 1rem; }
  article { position: relative; min-height: 300px; overflow: hidden; border-radius: var(--radius-lg); background: var(--color-secondary); }
  article > a { position: absolute; inset: 0; }
  .related-projects :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgb(12 17 22 / 84%), transparent 75%); }
  article section { position: absolute; right: 0; bottom: 0; left: 0; padding: 1.2rem; color: white; }
  article section > span { font-size: .78rem; font-weight: 800; }
  h3 { margin-block: .45rem; }
  p { color: rgb(255 255 255 / 82%); font-size: .9rem; }
  @media (min-width: 720px) { .related-projects > div { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
