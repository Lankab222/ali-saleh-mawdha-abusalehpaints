---
import SmartImage from "../../components/common/SmartImage.astro";
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/common/PageHero.astro";
import BlogFilters from "../../components/blog/BlogFilters.astro";
const settingsEntry = await getEntry("settings", "site");

if (!settingsEntry) {
  throw new Error("ملف إعدادات الموقع غير موجود");
}

const settings = settingsEntry.data;
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
const categories = [...new Set(posts.map((post) => post.data.category))].sort(
  (a, b) => a.localeCompare(b, "ar"),
);
---

<BaseLayout
  title="مقالات الدهانات والديكورات"
  description="دليل عملي عن الدهانات الداخلية والخارجية والديكورات والجبسات وورق الجدران والعزل والترميم واختيار الخامات والألوان."
  pageType="CollectionPage"
>
  <main id="main-content">
    <PageHero
      eyebrow="المدونة"
      title="مقالات الدهانات والديكورات والتشطيبات"
      description="معلومات تساعدك على فهم الخيارات ومراحل التنفيذ والأخطاء الشائعة قبل البدء بمشروعك."
    />
    <section class="section">
      <div class="container">
        <BlogFilters categories={categories} />{
          posts.length > 0 ? (
            <div class="posts-grid">
              {posts.map((post) => (
                <article
                  data-blog-post
                  data-category={post.data.category}
                  data-search-text={[
                    post.data.title,
                    post.data.description,
                    post.data.category,
                    post.data.author,
                    ...post.data.tags,
                  ].join(" ")}
                >
                  {post.data.image && (
                    <a class="media" href={`/blog/${post.id}/`}>
                      <SmartImage
                        src={post.data.image}
                        alt={post.data.imageAlt || post.data.title}
                        width={800}
                        height={500}
                        sizes="(min-width: 960px) 33vw, (min-width: 640px) 50vw, 100vw"
                        role="blog"
                      />
                    </a>
                  )}
                  <div class="body">
                    <a
                      class="category"
                      href={`/blog/category/${encodeURIComponent(post.data.category)}/`}
                    >
                      {post.data.category}
                    </a>
                    <h2>
                      <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                    </h2>
                    <p>{post.data.description}</p>
                    {post.data.tags.length > 0 && (
                      <div class="tags">
                        {post.data.tags.slice(0, 3).map((tag) => (
                          <a href={`/blog/tag/${encodeURIComponent(tag)}/`}>
                            #{tag}
                          </a>
                        ))}
                      </div>
                    )}
                    <div class="meta">
                      <time datetime={post.data.publishDate.toISOString()}>
                        {post.data.publishDate.toLocaleDateString(
                          settings.locale,
                          { year: "numeric", month: "long", day: "numeric" },
                        )}
                      </time>
                      <span>{post.data.author}</span>
                    </div>
                    <a class="more" href={`/blog/${post.id}/`}>
                      قراءة المقال ←
                    </a>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="empty-state">لا توجد مقالات منشورة حاليًا.</p>
          )
        }
      </div>
    </section>
  </main>
</BaseLayout>
<style>
  .posts-grid {
    display: grid;
    gap: 1.2rem;
  }
  article[hidden] {
    display: none;
  }
  article {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }
  article:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .media {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }
  .posts-grid :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }
  article:hover :global(img) {
    transform: scale(1.035);
  }
  .body {
    padding: 1.3rem;
  }
  .category,
  .more {
    color: var(--color-primary-dark);
    font-size: 0.86rem;
    font-weight: 800;
  }
  h2 {
    margin-block: 0.65rem;
    font-size: 1.35rem;
  }
  p {
    color: var(--color-text-muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-block: 0.8rem;
  }
  .tags a {
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: var(--color-primary-soft);
    color: var(--color-primary-dark);
    font-size: 0.76rem;
    font-weight: 700;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-block: 0.9rem;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }
  @media (min-width: 720px) {
    .posts-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1050px) {
    .posts-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
