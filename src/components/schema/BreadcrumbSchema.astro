---
import JsonLd from "./JsonLd.astro";

interface Item {
  name: string;
  url: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<JsonLd
  data={{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: items.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.name,
      item: item.url,
    })),
  }}
/>
