---
import SmartImage from "../common/SmartImage.astro";
interface PostItem { id: string; data: { title: string; description: string; image?: string; imageAlt?: string; category: string; publishDate: Date; }; }
interface Props { posts: PostItem[]; }
const { posts } = Astro.props;
---
{posts.length > 0 && <section class="related"><h2>مقالات قد تهمك</h2><div>{posts.map((post) => <article>{post.data.image && <a class="media" href={`/blog/${post.id}/`}><SmartImage src={post.data.image} alt={post.data.imageAlt || post.data.title} width={600} height={380} sizes="(min-width: 720px) 33vw, 100vw" role="blog" /></a>}<section><span>{post.data.category}</span><h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p></section></article>)}</div></section>}
<style>
  .related { margin-top: 4rem; }
  .related > h2 { margin-bottom: 1.4rem; font-size: clamp(1.7rem, 4vw, 2.4rem); }
  .related > div { display: grid; gap: 1rem; }
  article { overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
  .media { display: block; aspect-ratio: 16 / 10; overflow: hidden; }
  .related :global(img) { width: 100%; height: 100%; object-fit: cover; }
  article > section { padding: 1.1rem; }
  section > span { color: var(--color-primary-dark); font-size: .82rem; font-weight: 800; }
  h3 { margin-block: .5rem; font-size: 1.08rem; }
  p { color: var(--color-text-muted); font-size: .9rem; }
  @media (min-width: 720px) { .related > div { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
