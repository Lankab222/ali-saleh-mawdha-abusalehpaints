---
interface NavItem { title: string; href: string; }
interface Props { previous?: NavItem; next?: NavItem; }
const { previous, next } = Astro.props;
---
{(previous || next) && <nav class="project-navigation" aria-label="التنقل بين المشاريع"><div>{previous && <a href={previous.href}><span>المشروع السابق</span><strong>{previous.title}</strong></a>}</div><div>{next && <a href={next.href}><span>المشروع التالي</span><strong>{next.title}</strong></a>}</div></nav>}
<style>
  .project-navigation { display: grid; gap: 1rem; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--color-border); }
  .project-navigation > div:last-child { text-align: left; }
  a { display: grid; gap: .25rem; padding: 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
  a:hover { border-color: var(--color-primary); }
  span { color: var(--color-text-muted); font-size: .8rem; }
  strong { color: var(--color-primary-dark); }
  @media (min-width: 700px) { .project-navigation { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
