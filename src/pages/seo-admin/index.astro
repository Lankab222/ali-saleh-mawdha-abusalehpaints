---
import { getCollection, getEntry } from "astro:content";
import SeoAdminLayout from "../../layouts/SeoAdminLayout.astro";
import { applyDuplicateWarnings, bodyOf, createAudit } from "../../lib/seo/audit";
import type { AuditItem } from "../../lib/seo/types";
import imageManifest from "../../generated/image-manifest.json";

const settingsEntry = await getEntry("settings", "site");
const seoEntry = await getEntry("seoSettings", "settings");
const redirectsEntry = await getEntry("redirects", "settings");
if (!settingsEntry) throw new Error("ملف إعدادات الموقع غير موجود");
if (!seoEntry) throw new Error("ملف إعدادات السيو غير موجود");

const settings = settingsEntry.data;
const seo = seoEntry.data;
const redirects = redirectsEntry?.data.redirects.filter((item) => item.enabled) ?? [];
const productionUrl = (Astro.site?.toString() ?? settings.siteUrl).replace(/\/+$/, "");
const hostname = new URL(productionUrl).hostname;
const seoApiUrl = (import.meta.env.PUBLIC_SEO_API_URL || "").replace(/\/+$/, "");

const blogEntries = await getCollection("blog");
const serviceEntries = await getCollection("services");
const projectEntries = await getCollection("projects");

const audits: AuditItem[] = applyDuplicateWarnings([
  ...blogEntries.map((entry) =>
    createAudit({
      id: entry.id,
      collection: "blog",
      kind: "مقال",
      title: entry.data.title,
      description: entry.data.description,
      seoTitle: entry.data.seoTitle,
      seoDescription: entry.data.seoDescription,
      focusKeyword: entry.data.focusKeyword,
      canonical: entry.data.canonical,
      noindex: entry.data.noindex,
      indexingPriority: entry.data.indexingPriority,
      image: entry.data.ogImage || entry.data.image,
      imageAlt: entry.data.imageAlt,
      terms: entry.data.tags,
      body: bodyOf(entry),
      updatedDate: entry.data.updatedDate,
      faqCount: entry.data.faq.length,
      draft: entry.data.draft,
      path: `/blog/${entry.id}/`,
      supportsUpdatedDate: true,
      supportsFaq: true,
    }, seo.audit),
  ),
  ...serviceEntries.map((entry) =>
    createAudit({
      id: entry.id,
      collection: "services",
      kind: "خدمة",
      title: entry.data.title,
      description: entry.data.description,
      seoTitle: entry.data.seoTitle,
      seoDescription: entry.data.seoDescription,
      focusKeyword: entry.data.focusKeyword,
      canonical: entry.data.canonical,
      noindex: entry.data.noindex,
      indexingPriority: entry.data.indexingPriority,
      image: entry.data.ogImage || entry.data.image,
      imageAlt: entry.data.imageAlt,
      terms: entry.data.keywords,
      body: bodyOf(entry),
      updatedDate: entry.data.updatedDate,
      faqCount: entry.data.faq.length,
      draft: entry.data.draft,
      path: `/services/${entry.id}/`,
      supportsUpdatedDate: true,
      supportsFaq: true,
    }, seo.audit),
  ),
  ...projectEntries.map((entry) =>
    createAudit({
      id: entry.id,
      collection: "projects",
      kind: "مشروع",
      title: entry.data.title,
      description: entry.data.description,
      seoTitle: entry.data.seoTitle,
      seoDescription: entry.data.seoDescription,
      focusKeyword: entry.data.focusKeyword,
      canonical: entry.data.canonical,
      noindex: entry.data.noindex,
      indexingPriority: entry.data.indexingPriority,
      image: entry.data.ogImage || entry.data.coverImage,
      imageAlt: entry.data.coverImageAlt,
      terms: entry.data.services,
      body: bodyOf(entry),
      draft: entry.data.draft,
      path: `/projects/${entry.id}/`,
    }, seo.audit),
  ),
]).sort((a, b) => a.score - b.score || a.title.localeCompare(b.title, "ar"));

const published = audits.filter((item) => !item.draft);
const expectedIndexed = published.filter((item) => !item.noindex);
const draftCount = audits.filter((item) => item.draft).length;
const noindexCount = published.filter((item) => item.noindex).length;
const needsReviewCount = published.filter((item) => item.score < seo.audit.reviewScore).length;
const averageScore = audits.length
  ? Math.round(audits.reduce((total, item) => total + item.score, 0) / audits.length)
  : 0;
const issueCount = audits.reduce((total, item) => total + item.warnings.length, 0);

const mediaEntries = Object.values((imageManifest as any).images ?? {}) as any[];
const unreferencedImages = ((imageManifest as any).unreferenced ?? []) as string[];
const oversizedImages = mediaEntries.filter((item) => item.oversized);
const optimizedImages = mediaEntries.filter((item) => item.plain?.length > 0);
const watermarkedImages = mediaEntries.filter((item) => item.watermarked?.length > 0);
const originalBytes = mediaEntries.reduce((sum, item) => sum + (item.originalBytes || 0), 0);
const optimizedBytes = mediaEntries.reduce((sum, item) => {
  const webp = (item.plain || []).filter((v: any) => v.type === "image/webp").sort((a: any, b: any) => b.width - a.width)[0];
  return sum + (webp?.bytes || item.originalBytes || 0);
}, 0);
const estimatedSavings = originalBytes > 0 ? Math.max(0, Math.round((1 - optimizedBytes / originalBytes) * 100)) : 0;

const searchConsoleUrl = new URL("https://search.google.com/search-console");
searchConsoleUrl.searchParams.set("resource_id", seo.searchConsoleProperty || `sc-domain:${hostname}`);
const pageSpeedUrl = new URL("https://pagespeed.web.dev/");
pageSpeedUrl.searchParams.set("url", `${productionUrl}/`);
const richResultsUrl = new URL("https://search.google.com/test/rich-results");
richResultsUrl.searchParams.set("url", `${productionUrl}/`);

const clientData = {
  siteUrl: productionUrl,
  seoApiUrl,
  property: seo.searchConsoleProperty,
  targetPerformanceScore: seo.audit.targetPerformanceScore,
  expectedPaths: expectedIndexed.map((item) => item.path),
  content: audits.map((item) => ({
    title: item.title,
    path: item.path,
    draft: item.draft,
    noindex: item.noindex,
    priority: item.indexingPriority,
  })),
};

const scoreClass = (score: number) => score >= 85 ? "excellent" : score >= 70 ? "good" : "review";
---

<SeoAdminLayout
  title={`لوحة إدارة السيو الكاملة | ${settings.siteName}`}
  description="إدارة إعدادات السيو، فحص الصفحات، مراقبة الفهرسة والأداء والتحويلات."
>
  <main id="seo-admin-main" class="seo-dashboard" data-site-url={productionUrl} data-seo-api-url={seoApiUrl}>
    <header class="dashboard-header">
      <div>
        <span class="eyebrow">لوحة داخلية — غير مفهرسة</span>
        <h1>إدارة السيو والفهرسة</h1>
        <p>مركز موحّد لفحص المحتوى والزحف والفهرسة والأداء وإعدادات <strong>{settings.siteName}</strong>.</p>
      </div>
      <nav class="header-actions" aria-label="روابط الإدارة">
        <a class="button button-secondary" href="/admin/">إدارة المحتوى</a>
        <a class="button button-secondary" href="/admin/#/collections/seo_settings/entries/settings">إعدادات السيو</a>
        <a class="button button-primary" href="/" target="_blank" rel="noopener noreferrer">فتح الموقع</a>
      </nav>
    </header>

    <nav class="section-nav" aria-label="أقسام لوحة السيو">
      <a href="#overview">النظرة العامة</a>
      <a href="#technical">الفحص التقني</a>
      <a href="#crawler">فحص الموقع</a>
      <a href="#content">المحتوى</a>
      <a href="#media">الصور</a>
      <a href="#indexing">الفهرسة</a>
      <a href="#performance">الأداء</a>
      <a href="#settings">الإعدادات</a>
    </nav>

    <section id="overview" class="summary-grid" aria-label="ملخص السيو">
      <article class="summary-card"><span>المحتوى المنشور</span><strong>{published.length}</strong><small>مقال وخدمة ومشروع</small></article>
      <article class="summary-card"><span>متوسط الفحص</span><strong>{averageScore}%</strong><small>فحص داخلي إرشادي</small></article>
      <article class="summary-card"><span>بحاجة إلى مراجعة</span><strong>{needsReviewCount}</strong><small>أقل من {seo.audit.reviewScore}%</small></article>
      <article class="summary-card"><span>مشكلات مكتشفة</span><strong>{issueCount}</strong><small>قبل الفحص المباشر</small></article>
      <article class="summary-card"><span>noindex منشورة</span><strong>{noindexCount}</strong><small>مستبعدة من الخريطة</small></article>
      <article class="summary-card"><span>المسودات</span><strong>{draftCount}</strong><small>غير منشورة</small></article>
      <article class="summary-card"><span>الصور المحسنة</span><strong>{optimizedImages.length}</strong><small>من {mediaEntries.length} أصل</small></article>
      <article class="summary-card"><span>صور كبيرة</span><strong>{oversizedImages.length}</strong><small>تجاوزت حد التحذير</small></article>
      <article class="summary-card"><span>وسائط غير مستخدمة</span><strong>{unreferencedImages.length}</strong><small>لا يشير إليها المحتوى الحالي</small></article>
    </section>

    <section id="technical" class="dashboard-panel">
      <div class="panel-heading">
        <div><span class="eyebrow">فحص مباشر</span><h2>حالة الأرشفة التقنية</h2><p>يفحص النسخة المنشورة دون مفاتيح خارجية.</p></div>
        <button class="button button-secondary" type="button" data-run-live-checks>إعادة الفحص</button>
      </div>
      <div class="live-grid" aria-live="polite">
        {[
          ["https", "HTTPS والتحويل"], ["robots", "robots.txt"], ["sitemap", "Sitemap"],
          ["canonical", "Canonical"], ["schema", "Schema JSON-LD"], ["meta", "Meta Robots"],
          ["admin", "استبعاد لوحات الإدارة"], ["api", "Search Console API"],
        ].map(([key, label]) => (
          <article class="live-card is-loading" data-live-check={key}>
            <span class="live-indicator" aria-hidden="true"></span>
            <div><strong>{label}</strong><p data-live-message>جارٍ الفحص…</p><small data-live-detail></small></div>
          </article>
        ))}
      </div>
    </section>

    <section id="crawler" class="dashboard-panel">
      <div class="panel-heading panel-heading-wrap">
        <div><span class="eyebrow">زاحف داخلي</span><h2>فحص جميع صفحات Sitemap</h2><p>يفحص الحالة والعناوين والوصف وCanonical وH1 وSchema والصور والروابط.</p></div>
        <div class="inline-actions">
          <button class="button button-primary" type="button" data-start-crawl>بدء الفحص الكامل</button>
          <button class="button button-secondary" type="button" data-export-crawl disabled>تصدير CSV</button>
        </div>
      </div>
      <div class="progress-wrap" hidden data-crawl-progress-wrap>
        <div class="progress-head"><span data-crawl-status>جاهز</span><strong data-crawl-percent>0%</strong></div>
        <progress max="100" value="0" data-crawl-progress></progress>
      </div>
      <div class="crawl-summary" data-crawl-summary hidden></div>
      <div class="audit-table-wrap" data-crawl-results hidden>
        <table class="audit-table compact">
          <thead><tr><th>الصفحة</th><th>HTTP</th><th>الفهرسة</th><th>Title</th><th>Description</th><th>H1</th><th>Canonical</th><th>Schema</th><th>صور بلا alt</th><th>ملاحظات</th></tr></thead>
          <tbody data-crawl-table-body></tbody>
        </table>
      </div>
    </section>

    <section id="content" class="dashboard-panel">
      <div class="panel-heading panel-heading-wrap">
        <div><span class="eyebrow">المحتوى</span><h2>مراجعة الصفحات وحقول SEO</h2><p>يشمل التكرار والكلمة الأساسية وnoindex وCanonical وطول المحتوى.</p></div>
        <div class="filters">
          <label><span>بحث</span><input type="search" placeholder="اسم الصفحة أو الكلمة…" data-audit-search /></label>
          <label><span>النوع</span><select data-audit-kind><option value="all">الكل</option><option value="مقال">المقالات</option><option value="خدمة">الخدمات</option><option value="مشروع">المشاريع</option></select></label>
          <label><span>الحالة</span><select data-audit-status><option value="all">الكل</option><option value="review">بحاجة إلى مراجعة</option><option value="published">منشور</option><option value="noindex">noindex</option><option value="draft">مسودة</option></select></label>
        </div>
      </div>
      <p class="results-status" data-audit-results>عدد العناصر: {audits.length}</p>
      <div class="audit-table-wrap">
        <table class="audit-table">
          <thead><tr><th>الصفحة</th><th>النوع</th><th>النتيجة</th><th>الكلمة الأساسية</th><th>Title</th><th>Description</th><th>المحتوى</th><th>الفهرسة</th><th>الملاحظات</th><th>إدارة</th></tr></thead>
          <tbody>
            {audits.map((item) => (
              <tr data-audit-row data-title={`${item.title} ${item.focusKeyword}`.toLocaleLowerCase("ar")} data-kind={item.kind} data-score={item.score} data-draft={String(item.draft)} data-noindex={String(item.noindex)}>
                <td><strong>{item.title}</strong><small>{item.path}</small></td>
                <td><span class="type-badge">{item.kind}</span></td>
                <td><span class:list={["score-badge", scoreClass(item.score)]}>{item.score}%</span></td>
                <td>{item.focusKeyword || <span class="muted">غير محددة</span>}</td>
                <td>{item.seoTitleLength}</td><td>{item.descriptionLength}</td><td>{item.contentLength}</td>
                <td>{item.draft ? <span class="status-pill draft">مسودة</span> : item.noindex ? <span class="status-pill noindex">noindex</span> : <span class="status-pill indexed">index</span>}</td>
                <td>{item.warnings.length ? <details><summary>{item.warnings.length} ملاحظة</summary><ul>{item.warnings.map((warning) => <li>{warning}</li>)}</ul></details> : <span class="all-good">مكتمل</span>}</td>
                <td><div class="row-actions"><a href={item.editPath}>تعديل</a>{!item.draft && <a href={item.path} target="_blank" rel="noopener noreferrer">فتح</a>}</div></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>


    <section id="media" class="dashboard-panel">
      <div class="panel-heading panel-heading-wrap">
        <div><span class="eyebrow">وسائط وأداء</span><h2>صحة الصور والعلامة المائية</h2><p>يعتمد على Manifest الذي يولده <code>npm run images:build</code> قبل البناء.</p></div>
        <a class="button button-secondary" href="/admin/#/collections/settings/entries/site">إعدادات الصور</a>
      </div>
      <div class="api-metrics">
        <article><span>الصور الأصلية</span><strong>{mediaEntries.length}</strong></article>
        <article><span>محسنة</span><strong>{optimizedImages.length}</strong></article>
        <article><span>بعلامة مائية</span><strong>{watermarkedImages.length}</strong></article>
        <article><span>غير مستخدمة</span><strong>{unreferencedImages.length}</strong></article>
        <article><span>توفير تقديري</span><strong>{estimatedSavings}%</strong></article>
      </div>
      {oversizedImages.length > 0 ? (
        <div class="audit-table-wrap">
          <table class="audit-table compact">
            <thead><tr><th>الصورة</th><th>الحجم الأصلي</th><th>الأبعاد</th><th>الحالة</th></tr></thead>
            <tbody>{oversizedImages.slice(0, 30).map((item) => <tr><td><code>{item.src}</code></td><td>{Math.round(item.originalBytes / 1024)} KB</td><td>{item.originalWidth}×{item.originalHeight}</td><td><span class="status-pill noindex">تحتاج ضغط/مراجعة</span></td></tr>)}</tbody>
          </table>
        </div>
      ) : <p class="all-good">لا توجد صور أصلية تتجاوز حد التحذير الحالي.</p>}
      {unreferencedImages.length > 0 && (
        <details class="media-unused">
          <summary>عرض الوسائط غير المستخدمة حاليًا ({unreferencedImages.length})</summary>
          <p class="muted">هذه الملفات لا يشير إليها محتوى الموقع الحالي، لذلك يتخطاها نظام التحسين افتراضيًا. لا تحذفها إلا بعد التأكد أنها ليست محفوظة لاستخدام لاحق.</p>
          <ul>{unreferencedImages.slice(0, 60).map((src) => <li><code>{src}</code></li>)}</ul>
        </details>
      )}
      <p class="important-note">العلامة المائية تُدمج داخل النسخ المولدة نفسها، لذلك لا تضيف JavaScript أو طبقة CSS فوق الصور في المتصفح.</p>
    </section>

    <section id="indexing" class="dashboard-panel">
      <div class="panel-heading"><div><span class="eyebrow">Google Search Console</span><h2>مراقبة الفهرسة والبحث</h2><p>تعمل البيانات الحية بعد ربط Worker الاختياري.</p></div><button class="button button-secondary" type="button" data-refresh-search-console>تحديث البيانات</button></div>
      {!seoApiUrl && <div class="setup-callout"><strong>الربط غير مفعل بعد</strong><p>أضف Worker المرفق ثم عرّف <code>PUBLIC_SEO_API_URL</code>. تبقى جميع أدوات الفحص المحلية عاملة دون Worker.</p><a href="/admin/#/collections/seo_settings/entries/settings">مراجعة إعدادات السيو</a></div>}
      <div class="api-metrics">
        <article><span>النقرات — 28 يومًا</span><strong data-gsc-clicks>—</strong></article>
        <article><span>مرات الظهور</span><strong data-gsc-impressions>—</strong></article>
        <article><span>CTR</span><strong data-gsc-ctr>—</strong></article>
        <article><span>متوسط الموضع</span><strong data-gsc-position>—</strong></article>
      </div>
      <div class="two-columns">
        <div><h3>فحص عنوان URL</h3><label class="block-label"><span>الصفحة</span><select data-inspection-url>{expectedIndexed.map((item) => <option value={`${productionUrl}${item.path}`}>{item.title}</option>)}</select></label><button class="button button-primary" type="button" data-inspect-url>فحص الفهرسة</button><div class="inspection-result" data-inspection-result><p class="muted">اختر صفحة ثم اضغط فحص الفهرسة.</p></div></div>
        <div><h3>أهم طلبات البحث</h3><div class="simple-table" data-gsc-queries><p class="muted">لا توجد بيانات محملة.</p></div></div>
      </div>
      <p class="important-note">لا تتضمن اللوحة زرًا آليًا لطلب فهرسة الصفحات العادية؛ استخدم فحص URL في Search Console عند الحاجة.</p>
    </section>

    <section id="performance" class="dashboard-panel">
      <div class="panel-heading"><div><span class="eyebrow">PageSpeed</span><h2>الأداء ومؤشرات الويب</h2><p>فحص الصفحة عبر Worker عند إضافة مفتاح PageSpeed الاختياري.</p></div></div>
      <div class="performance-controls"><label><span>الرابط</span><input type="url" value={`${productionUrl}/`} data-pagespeed-url /></label><label><span>الجهاز</span><select data-pagespeed-strategy><option value="mobile">الجوال</option><option value="desktop">سطح المكتب</option></select></label><button class="button button-primary" type="button" data-run-pagespeed>فحص الأداء</button></div>
      <div class="api-metrics performance-metrics"><article><span>الأداء</span><strong data-psi-score>—</strong></article><article><span>LCP</span><strong data-psi-lcp>—</strong></article><article><span>CLS</span><strong data-psi-cls>—</strong></article><article><span>INP/TBT</span><strong data-psi-inp>—</strong></article></div>
    </section>

    <section id="settings" class="dashboard-panel">
      <div class="panel-heading"><div><span class="eyebrow">الإعدادات</span><h2>إدارة السيو والتحويلات</h2><p>تُحفظ التغييرات عبر Decap CMS ثم يعاد بناء الموقع تلقائيًا.</p></div></div>
      <div class="settings-grid">
        <article><h3>إعدادات السيو العامة</h3><dl><div><dt>قالب العنوان</dt><dd>{seo.titleTemplate}</dd></div><div><dt>خاصية Search Console</dt><dd>{seo.searchConsoleProperty}</dd></div><div><dt>وسوم noindex</dt><dd>{seo.noindexTagPages ? "نعم" : "لا"}</dd></div><div><dt>تصنيفات noindex</dt><dd>{seo.noindexCategoryPages ? "نعم" : "لا"}</dd></div></dl><a class="button button-secondary" href="/admin/#/collections/seo_settings/entries/settings">تعديل الإعدادات</a></article>
        <article><h3>robots.txt</h3><ul>{seo.robots.disallow.map((path) => <li><code>{path}</code></li>)}</ul><a class="button button-secondary" href="/robots.txt" target="_blank" rel="noopener noreferrer">فتح الملف</a></article>
        <article><h3>الصور</h3><dl><div><dt>المعالجة</dt><dd>{settings.imageProcessing.enabled ? "مفعلة" : "متوقفة"}</dd></div><div><dt>العلامة المائية</dt><dd>{settings.watermark.enabled ? "مفعلة" : "متوقفة"}</dd></div></dl><a class="button button-secondary" href="/admin/#/collections/settings/entries/site">إدارة الصور</a></article>
        <article><h3>التحويلات</h3><strong class="large-number">{redirects.length}</strong><p>قاعدة مفعلة، تُولد داخل <code>public/_redirects</code> قبل البناء.</p><a class="button button-secondary" href="/admin/#/collections/redirect_settings/entries/settings">إدارة التحويلات</a></article>
        <article><h3>أدوات سريعة</h3><div class="quick-links"><a href={searchConsoleUrl.toString()} target="_blank" rel="noopener noreferrer">Search Console</a><a href={pageSpeedUrl.toString()} target="_blank" rel="noopener noreferrer">PageSpeed</a><a href={richResultsUrl.toString()} target="_blank" rel="noopener noreferrer">Rich Results</a><a href="/sitemap-index.xml" target="_blank" rel="noopener noreferrer">Sitemap</a></div></article>
      </div>
    </section>

    <footer class="dashboard-footer"><span>الدومين:</span><code>{productionUrl}</code><span>المتوقع فهرسته من المحتوى:</span><strong>{expectedIndexed.length}</strong><span>الإصدار:</span><strong>2.0.0</strong></footer>
  </main>

  <script id="seo-admin-data" type="application/json" set:html={JSON.stringify(clientData).replace(/</gu, "\\u003c")}></script>
</SeoAdminLayout>

<script>
  import "../../scripts/seo-admin.ts";
</script>
