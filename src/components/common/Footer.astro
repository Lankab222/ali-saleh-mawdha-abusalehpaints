---
interface Props {
  siteName: string;
  footerText: string;
  description?: string;
  logo?: string;
  phone?: string;
  phoneDisplay?: string;
  whatsapp?: string;
  email?: string;
  address?: string;
  facebook?: string;
  instagram?: string;
  x?: string;
  youtube?: string;
  services?: { label: string; href: string }[];
  developerCredit?: { enabled: boolean; name: string; whatsapp: string };
}

const props = Astro.props;
const footerServices = props.services ?? [];
const credit = props.developerCredit;
const year = new Date().getFullYear();
const socialLinks = [
  { label: "فيسبوك", href: props.facebook },
  { label: "إنستغرام", href: props.instagram },
  { label: "منصة X", href: props.x },
  { label: "يوتيوب", href: props.youtube },
].filter((item): item is { label: string; href: string } => Boolean(item.href));
---

<footer class="site-footer">
  <div class="container footer-grid">
    <section class="footer-brand">
      <a class="footer-logo" href="/">
        {
          props.logo && (
            <img
              src={props.logo}
              alt={`شعار ${props.siteName}`}
              width="52"
              height="52"
              loading="lazy"
            />
          )
        }
        <strong>{props.siteName}</strong>
      </a>
      {props.description && <p>{props.description}</p>}
      {
        socialLinks.length > 0 && (
          <div class="social-links">
            {socialLinks.map((item) => (
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                {item.label}
              </a>
            ))}
          </div>
        )
      }
    </section>

    <section>
      <h2>روابط سريعة</h2>
      <nav class="footer-links" aria-label="روابط الفوتر">
        <a href="/">الرئيسية</a><a href="/about/">من نحن</a><a href="/services/"
          >الخدمات</a
        ><a href="/projects/">المشاريع</a><a href="/blog/">المقالات</a><a
          href="/contact/">تواصل معنا</a
        >
      </nav>
    </section>

    <section>
      <h2>خدماتنا</h2>
      <nav class="footer-links" aria-label="روابط الخدمات">
        {footerServices.length > 0 ? footerServices.map((item) => <a href={item.href}>{item.label}</a>) : <a href="/services/">عرض جميع الخدمات</a>}
      </nav>
    </section>

    <section>
      <h2>تواصل معنا</h2>
      <div class="contact-list">
        {
          props.phone && (
            <a href={`tel:${props.phone}`}>
              <>
                <strong>الهاتف</strong>
                <span>{props.phoneDisplay || props.phone}</span>
              </>
            </a>
          )
        }
        {
          props.whatsapp && (
            <a
              href={`https://wa.me/${props.whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <>
                <strong>واتساب</strong>
                <span>{props.phoneDisplay || props.whatsapp}</span>
              </>
            </a>
          )
        }
        {
          props.email && (
            <a href={`mailto:${props.email}`}>
              <>
                <strong>البريد</strong>
                <span>{props.email}</span>
              </>
            </a>
          )
        }
        {
          props.address && (
            <div>
              <>
                <strong>نطاق الخدمة</strong>
                <span>{props.address}</span>
              </>
            </div>
          )
        }
      </div>
    </section>
  </div>

  <div class="container footer-bottom">
    <p>{props.footerText} © {year} {props.siteName}</p>
    <nav aria-label="الصفحات القانونية">
      <a href="/privacy/">سياسة الخصوصية</a><a href="/terms/">شروط الاستخدام</a>
    </nav>
  </div>
  {credit?.enabled && credit.name && credit.whatsapp && (
    <div class="footer-credit">
      <span>تصميم وتطوير</span>
      <a
        href={`https://wa.me/${credit.whatsapp}?text=${encodeURIComponent(`مرحبًا ${credit.name}، أرغب في التواصل معك بشأن تصميم وتطوير موقع.`)}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`مراسلة ${credit.name} عبر واتساب`}
      >
        {credit.name}
      </a>
    </div>
  )}
</footer>

<style>
  .footer-credit {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.35rem;

    width: 100%;
    margin-top: 2rem;
    padding: 1rem;

    border-top: 1px solid rgb(255 255 255 / 12%);
    font-family: var(--font-family);
    font-size: 0.9rem;
    text-align: center;
  }

  .footer-credit span {
    opacity: 0.75;
  }

  .footer-credit a {
    color: inherit;
    font-weight: 700;
    text-decoration: none;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .footer-credit a:hover {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .footer-credit a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 4px;
  }

  .footer-credit a:active {
    transform: scale(0.97);
  }
  .site-footer {
    margin-top: 4rem;
    padding-block: 4rem 1.5rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .footer-grid {
    display: grid;
    gap: 2.4rem;
  }
  .footer-brand {
    max-width: 470px;
  }
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }
  .footer-logo img {
    width: 48px;
    height: 48px;
    object-fit: contain;
  }
  .footer-brand p,
  .footer-links a,
  .contact-list span {
    color: var(--color-text-muted);
  }
  .site-footer h2 {
    margin-bottom: 1rem;
    font-size: 1.05rem;
  }
  .footer-links,
  .contact-list {
    display: grid;
    gap: 0.68rem;
  }
  .footer-links a {
    width: fit-content;
  }
  .footer-links a:hover {
    color: var(--color-primary);
  }
  .contact-list a,
  .contact-list div {
    display: grid;
    gap: 0.1rem;
  }
  .contact-list strong {
    font-size: 0.84rem;
  }
  .contact-list span {
    overflow-wrap: anywhere;
  }
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }
  .social-links a {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: white;
    font-size: 0.82rem;
    font-weight: 700;
  }
  .footer-bottom {
    display: grid;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
  .footer-bottom p {
    margin: 0;
  }
  .footer-bottom nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  @media (min-width: 700px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .footer-bottom {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
  @media (min-width: 1050px) {
    .footer-grid {
      grid-template-columns: minmax(280px, 1.5fr) repeat(3, minmax(150px, 1fr));
    }
  }
</style>
