---
interface Props {
  phone?: string;
  phoneDisplay?: string;
  whatsapp?: string;
  email?: string;
  instagram?: string;
  whatsappMessage?: string;
}

const {
  phone,
  whatsapp,
  email,
  instagram,
  whatsappMessage = "مرحبًا، أريد الاستفسار عن خدماتكم",
} = Astro.props;

const encodedMessage = encodeURIComponent(whatsappMessage);

const items = [
  whatsapp && {
    label: "واتساب",
    href: `https://wa.me/${whatsapp}?text=${encodedMessage}`,
    external: true,
    icon: "wa",
  },
  phone && {
    label: "اتصال",
    href: `tel:${phone}`,
    external: false,
    icon: "phone",
  },
  instagram && {
    label: "إنستغرام",
    href: instagram,
    external: true,
    icon: "ig",
  },
  email && {
    label: "البريد",
    href: `mailto:${email}`,
    external: false,
    icon: "mail",
  },
].filter(Boolean) as {
  label: string;
  href: string;
  external: boolean;
  icon: "wa" | "phone" | "ig" | "mail";
}[];
---

{
  items.length > 0 && (
    <nav class="floating-socials" aria-label="وسائل التواصل السريعة">
      {items.map((item) => (
        <a
          class={`floating-social floating-social--${item.icon}`}
          href={item.href}
          aria-label={item.label}
          title={item.label}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noopener noreferrer" : undefined}
        >
          <span class="icon" aria-hidden="true">
            {item.icon === "wa" && (
              <svg viewBox="0 0 24 24">
                <path
                  d="M20.5 11.8a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.3-4.7a8.5 8.5 0 1 1 16.2-4Zm-8.4-6.1c-.3 0-.6 0-.8.5l-.9 2c-.1.3-.1.6.1.9.3.5.9 1.5 2.1 2.5 1.4 1.2 2.6 1.6 3.2 1.8.4.1.7 0 .9-.2l1.2-1.5c.2-.3.2-.6-.1-.7l-2.1-1c-.3-.1-.5-.1-.7.2l-.7.9c-.2.2-.4.2-.7.1-.7-.3-1.6-.8-2.4-1.7-.6-.7-1-1.4-1.2-1.9-.1-.3 0-.5.2-.7l.6-.7c.2-.2.3-.5.2-.8l-.9-2.2c-.1-.3-.4-.4-.6-.4Z"
                  fill="currentColor"
                />
              </svg>
            )}

            {item.icon === "phone" && (
              <svg viewBox="0 0 24 24">
                <path
                  d="M7.2 3.5 9.4 8c.2.4.1.8-.2 1.1l-1.5 1.5a15 15 0 0 0 5.7 5.7l1.5-1.5c.3-.3.7-.4 1.1-.2l4.5 2.2c.4.2.6.6.5 1l-.5 2.4c-.1.5-.5.8-1 .8C10.4 21 3 13.6 3 4.5c0-.5.3-.9.8-1l2.4-.5c.4-.1.8.1 1 .5Z"
                  fill="currentColor"
                />
              </svg>
            )}

            {item.icon === "ig" && (
              <svg viewBox="0 0 24 24">
                <rect
                  x="3"
                  y="3"
                  width="18"
                  height="18"
                  rx="5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                />
                <circle
                  cx="12"
                  cy="12"
                  r="4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
              </svg>
            )}

            {item.icon === "mail" && (
              <svg viewBox="0 0 24 24">
                <path
                  d="M3 6h18v12H3V6Zm1.5 1.5L12 13l7.5-5.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linejoin="round"
                />
              </svg>
            )}
          </span>

          <span class="label" aria-hidden="true">
            {item.label}
          </span>
        </a>
      ))}
    </nav>
  )
}

<style>
  .floating-socials {
    position: fixed;
    top: 57%;
    left: 0.8rem;
    z-index: 1200;
    display: grid;
    gap: 0.45rem;
    transform: translateY(-50%);
    pointer-events: auto;
  }

  .floating-social {
    position: relative;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 58%);
    border-radius: 50%;
    color: #fff;
    box-shadow:
      0 8px 18px rgb(15 23 42 / 20%),
      inset 0 1px 0 rgb(255 255 255 / 22%);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      filter 180ms ease;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .floating-social--wa {
    background: #20b859;
  }

  .floating-social--phone {
    background: #2563d9;
  }

  .floating-social--ig {
    background: linear-gradient(145deg, #833ab4, #e1306c 55%, #f77737);
  }

  .floating-social--mail {
    background: #536173;
  }

  .floating-social:hover,
  .floating-social:focus-visible {
    transform: translateX(3px) scale(1.06);
    filter: saturate(1.08);
    box-shadow:
      0 11px 24px rgb(15 23 42 / 27%),
      inset 0 1px 0 rgb(255 255 255 / 28%);
  }

  .floating-social:active {
    transform: scale(0.94);
  }

  .floating-social:focus-visible {
    outline: 3px solid rgb(255 255 255 / 92%);
    outline-offset: 3px;
  }

  .icon {
    display: grid;
    width: 22px;
    height: 22px;
    place-items: center;
  }

  svg {
    display: block;
    width: 22px;
    height: 22px;
  }

  .label {
    position: absolute;
    top: 50%;
    left: calc(100% + 0.55rem);
    padding: 0.34rem 0.58rem;
    border: 1px solid rgb(255 255 255 / 65%);
    border-radius: 999px;
    background: rgb(255 255 255 / 96%);
    color: var(--color-text);
    box-shadow: 0 7px 18px rgb(15 23 42 / 14%);
    font-family: var(--font-family);
    font-size: 0.76rem;
    font-weight: 700;
    white-space: nowrap;
    opacity: 0;
    transform: translate(-5px, -50%);
    visibility: hidden;
    transition:
      opacity 160ms ease,
      transform 160ms ease,
      visibility 160ms ease;
  }

  .floating-social:hover .label,
  .floating-social:focus-visible .label {
    opacity: 1;
    transform: translate(0, -50%);
    visibility: visible;
  }

  @media (max-width: 640px) {
    .floating-socials {
      top: 80%;
      left: 0.55rem;
      gap: 0.38rem;
    }

    .floating-social {
      width: 42px;
      height: 42px;
    }

    .icon,
    svg {
      width: 21px;
      height: 21px;
    }

    .label {
      display: none;
    }
  }

  @media (max-height: 560px) {
    .floating-socials {
      top: 56%;
      gap: 0.3rem;
    }

    .floating-social {
      width: 39px;
      height: 39px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-social,
    .label {
      transition: none;
    }
  }
</style>
