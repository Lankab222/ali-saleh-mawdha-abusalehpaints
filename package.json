{
  "name": "alraqabi-astro-business-template",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "cms": "decap-server",
    "seo:redirects": "node scripts/generate-redirects.mjs",
    "prebuild": "npm run seo:redirects && npm run images:build && npm run validate",
    "seo:check": "node scripts/seo-preflight.mjs",
    "images:build": "node scripts/optimize-images.mjs",
    "client:setup": "node scripts/client-setup.mjs",
    "validate": "node scripts/validate-template.mjs",
    "predev": "npm run images:build",
    "indexnow": "node scripts/indexnow-submit.mjs",
    "client:init": "node scripts/client-init.mjs",
    "audit:dist": "node scripts/audit-dist.mjs",
    "quality": "npm run build && npm run audit:dist"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.7"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "decap-server": "^3.9.1",
    "sharp": "^0.35.3"
  }
}
